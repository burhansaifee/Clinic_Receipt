{ 
  "name": "clinic",
  "private": true,
  "version": "3.0.2",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder",
    "build:mac": "xattr -cr public src 2>/dev/null || true && tsc -b && vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir && hdiutil create -volname \"Buvora\" -srcfolder release/3.0.2/mac-arm64 -ov -format UDZO release/3.0.2/Buvora-3.0.2-mac.dmg",
    "build:win": "tsc -b && vite build && electron-builder --windows",
    "postinstall": "npx @electron/rebuild -f -w better-sqlite3",
    "key": "node scripts/generate-key.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.1.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.8.0",
    "node-machine-id": "^1.1.12",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.buvora.clinic",
    "productName": "Buvora",
    "executableName": "Buvora",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "burhansaifee",
        "repo": "Clinic_Receipt",
        "private": "false"
      }
    ],
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Buvora"
    }
  }
}
